# CareerOS AI configuration — copy to `.env.local` and fill in.
# `.env.local` is gitignored; never commit real credentials.

# "mock" (default): the whole product runs with placeholder AI responses,
# no credentials needed. "live": real provider calls for the mock-interview
# workflow (speech-to-text + interview feedback). If AI_MODE=live but no
# API key is set, the app silently falls back to mock mode so it always starts.
AI_MODE=mock

# Any OpenAI-compatible provider works. Server-side only — this key is
# never shipped to the browser bundle.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Speech-to-text model (audio/transcriptions endpoint).
STT_MODEL=whisper-1

# Interview-feedback model (chat/completions endpoint, must support JSON
# response format).
LLM_MODEL=gpt-4o-mini

# --- Phase 9: real-user accounts (Supabase) ---------------------------------
# Leave empty to run the app as a pure demo (no login, mock data only).
# SQL schema: supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
